# --- Server ---
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Comma-separated list of allowed origins. Vite picks the next free port
# when 5173 is taken (5174, 5175, …) so include a few defaults for dev.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- Stellar (testnet) ---
STELLAR_NETWORK=testnet
# If the public SDF RPC rate-limits your deploy region (Railway's IP block
# has been throttled before), switch to a mirror — Gateway.fm has been
# stable for us:
#   https://soroban-rpc.testnet.stellar.gateway.fm
# PublicNode also runs one:
#   https://stellar-soroban-rpc-testnet.publicnode.com
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ADMIN_PUBLIC_KEY=GBYU6P367RQIUR63NXCNLWE2H5DIVC7BTJL6HEH7SAKSCTUIU7MH5KRY
# Admin secret key — NEVER commit. Load from your local keystore only.
ADMIN_SECRET_KEY=
NATIVE_XLM_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC
USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
SUPPORTED_ASSETS=XLM,USDC
CRACKD_VAULT_ID=CAFRPUU36IQQJX5O6X4XTYWQI2X7N5WXK37HUSOA256IEYDDVJGVVTHQ
# Duel v4 — adds admin upgrade(new_wasm_hash) + per-player nonce entropy
# (deterministic across sim/exec, avoids footprint trap on create_game).
CRACKD_DUEL_ID=CAE7PEWHVT6AL37MVRB7LOFJPGPKGGYVWKYXGZAMTRGKIRY5ZSXWLXVS
GAME_HUB_ID=CB4VZAT2U3UC6XFK3N23SKRF2NDCMP3QHJYMCHHFMZO7MRQO6DQ2EMYG
GAME_HUB_ENABLED=true

# Friendbot endpoint — used by POST /api/onboarding/fund to top up
# fresh Privy embedded wallets on first sign-in. Testnet only.
STELLAR_FRIENDBOT_URL=https://friendbot.stellar.org

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=200

# --- Redis ---
REDIS_URL=redis://localhost:6379

